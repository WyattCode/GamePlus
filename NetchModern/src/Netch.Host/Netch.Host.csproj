<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Netch.Host</RootNamespace>
    <AssemblyName>gameplus-host</AssemblyName>
    <!-- Dev-build default. Release publish injects the electron-app/package.json version via -p:Version in build.ps1. -->
    <Version>3.0.0</Version>
    <!-- Headless: no window, no console popup when spawned by Electron. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Netch.Core\Netch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Netch.Tests" />
  </ItemGroup>

</Project>
